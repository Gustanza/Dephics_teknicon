# Teknicon — Apache rules for the static build (cPanel hosting).
#
# vite-ssg writes every page as a flat file — /about -> about.html,
# /projects/zimbili-bridge -> projects/zimbili-bridge.html — but every link on the site
# uses the clean URL. Clicking a link works without this file, because the router
# swaps the page in the browser. Opening a link in a NEW TAB or refreshing asks the
# server for /about, and Apache has no file by that name, so it answered 404.
# /services was worse: a services/ folder (the five service pages) sits beside
# services.html, so Apache redirected to /services/ and printed a directory listing.

# Never list a folder's files.
Options -Indexes

# Do not bounce /services to /services/ just because a services/ folder exists —
# the rewrite below must see /services and serve services.html.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /about/ -> /about  (the site's canonical URLs have no trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about -> about.html, /projects/zimbili-bridge -> projects/zimbili-bridge.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Anything else: the site's own 404 page, prerendered by the build.
ErrorDocument 404 /404.html
